{
  "name": "an-toastjs",
  "description": "Una libería para crear notificaciones con toasts",
  "version": "1.0.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "tsup",
    "dev": "vite",
    "build": "tsc && vite build &&  copy src\\*.d.ts dist\\",
    "preview": "vite preview"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^4.3.0"
  },
  "keywords": [
    "toast",
    "notification",
    "toastjs",
    "vanilla",
    "typescript",
    "javascript",
    "library",
    "an-toastjs"
  ],
  "author": "Angel Marcos",
  "license": "MIT",
  "files": [
    "dist"
  ]
}
